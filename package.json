{
  "name": "planner-casamento",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "prisma generate --schema=prisma/schema.prisma && next dev",
    "build": "prisma generate --schema=prisma/schema.vercel.prisma && prisma migrate deploy --schema=prisma/schema.vercel.prisma && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate:local": "prisma generate --schema=prisma/schema.prisma",
    "db:generate:vercel": "prisma generate --schema=prisma/schema.vercel.prisma",
    "db:export:sqlite": "tsx prisma/export-sqlite.ts",
    "db:import:sqlite": "npm run db:generate:vercel && tsx prisma/import-sqlite-export.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.4.0",
    "next": "16.3.5",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
