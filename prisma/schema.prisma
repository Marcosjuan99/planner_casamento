generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  icon        String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  items       Item[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Responsible {
  id          String            @id @default(cuid())
  name        String
  type        String
  description String?
  items       ItemResponsible[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model WeddingSettings {
  id          String   @id @default("main")
  weddingDate DateTime?
  updatedAt   DateTime @updatedAt
}

model CalendarEvent {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id          String    @id @default(cuid())
  name        String
  company     String?
  phone       String?
  whatsapp    String?
  instagram   String?
  email       String?
  service     String?
  notes       String?
  link        String?
  items       Item[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Item {
  id                 String            @id @default(cuid())
  name               String
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id])
  description        String?
  status             String            @default("Planejando")
  priority           String            @default("Média")
  dueDate            DateTime?
  paymentDate        DateTime?
  notes              String?
  tags               String?
  acquisitionType    String            @default("Compra")
  sourceType         String?
  isGift             Boolean           @default(false)
  estimatedValue     Int               @default(0)
  contractedValue    Int               @default(0)
  finalValue         Int               @default(0)
  amountForCouple    Int               @default(0)
  supplierId         String?
  supplier           Supplier?         @relation(fields: [supplierId], references: [id])
  responsibleConnections ItemResponsible[]
  payments           Payment[]
  installments       Installment[]
  materials          Material[]
  tasks              Task[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model ItemResponsible {
  id            String      @id @default(cuid())
  itemId        String
  item          Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  responsibleId String
  responsible   Responsible @relation(fields: [responsibleId], references: [id], onDelete: Cascade)
  role          String?
  createdAt     DateTime    @default(now())

  @@unique([itemId, responsibleId])
}

model Payment {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  amount      Int
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
}

model Installment {
  id            String    @id @default(cuid())
  itemId        String
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  number        Int
  amount        Int
  dueDate       DateTime?
  paidDate      DateTime?
  status        String    @default("Pendente")
  paymentMethod String?
  notes         String?
  createdAt     DateTime  @default(now())
}

model Material {
  id             String    @id @default(cuid())
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name           String
  quantity       Float     @default(1)
  unit           String?
  estimatedValue Int       @default(0)
  actualValue    Int       @default(0)
  status         String    @default("Não comprado")
  dueDate        DateTime?
  whereToBuy     String?
  notes          String?
  createdAt      DateTime  @default(now())
}

model Task {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  name        String
  assignee    String?
  dueDate     DateTime?
  status      String    @default("Pendente")
  priority    String    @default("Média")
  createdAt   DateTime  @default(now())
}
